# ── TypeSafe Jev: the model that picks the operation and the element ────
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# ── Small LLM: used only when the chosen operation is TYPE_TEXT ─────────
# Any OpenAI-compatible endpoint. Defaults to OpenRouter.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none

# ── The phone: AutoX.js MCP server ──────────────────────────────────────
# In the app, enable Settings → MCP service and point this at the phone.
AUTOX_MCP_URL=http://192.168.1.100:27190/mcp
AUTOX_MCP_TOKEN=

# ── Swipe tuning ───────────────────────────────────────────────────────
# Duration in milliseconds passed to the phone-side ``swipe`` tool for
# every SCROLL_* / SWIPE_* action. Higher = slower, more reliable on
# Compose / lazy lists. 400ms is the default; bump to 600ms if you see
# gestures being swallowed.
AUTOX_SWIPE_DURATION=400

# ── Local inspector (browser UI at http://127.0.0.1:8767) ───────────────
AUTOX_DEMO_PORT=8767

# ── Loop bounds ─────────────────────────────────────────────────────────
AGENT_MAX_STEPS=60

# ── Decision / text backends ────────────────────────────────────────────
# ``typesafe`` (default) talks to TypeSafe Jev; ``scripted`` is offline.
AGENT_DECISION_BACKEND=typesafe
AGENT_TEXT_BACKEND=helper

# ── Optional LLM enhancements (off by default) ─────────────────────────
# Each can be flipped from the CLI with --plan/--no-plan, --llm-fallback/
# --no-llm-fallback, --summarize/--no-summarize. They all reuse the
# TEXT_MODEL_* credentials above.
#
# Pre-task planning: the auxiliary LLM reads the goal + installed APP
# list, returns a short step plan (injected into Jev's state.task_plan)
# plus the labels of relevant APPs (used for the LAUNCH_APP surface).
AGENT_LLM_PLAN=0

# Deadlock breaker: when Jev repeats the same action 3 times in a row
# (or scrolls 5 times without clicking), the auxiliary LLM is asked
# how to escape. The suggestion is either executed directly
# (PRESS_BACK / PRESS_HOME / SWIPE_* / SCROLL_*) or injected as
# LLM_SUGGESTION so Jev obeys it next tick.
AGENT_LLM_FALLBACK=0

# Post-run summary: 1–2 sentence Chinese summary of the run, surfaced
# in the CLI log and (when the dashboard ingests --json output) as a
# summary card.
AGENT_LLM_SUMMARY=0

# Comma-separated allowlist for the LAUNCH_APP surface. ``-`` prefixes
# remove a package. Leave empty to keep every detected installed app.
# Example:
# LAUNCH_APP_ALLOWLIST=com.android.settings,-com.android.systemui
LAUNCH_APP_ALLOWLIST=

# Device locale (used by plan_task and the future dashboard).
AUTOX_DEVICE_LANG=zh-CN