# ── TypeSafe Jev: the model that picks the operation and the element ────
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# ── Small LLM: used only when the chosen operation is TYPE_TEXT ─────────
# Any OpenAI-compatible endpoint. Defaults to OpenRouter.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none

# ── The phone: AutoX.js MCP server ──────────────────────────────────────
# In the app, enable Settings → MCP service and point this at the phone.
AUTOX_MCP_URL=http://192.168.1.100:27190/mcp
AUTOX_MCP_TOKEN=

# ── Local inspector (browser UI at http://127.0.0.1:8767) ───────────────
AUTOX_DEMO_PORT=8767

# ── Loop bounds ─────────────────────────────────────────────────────────
AGENT_MAX_STEPS=60
